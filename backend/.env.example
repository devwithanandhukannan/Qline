# ---- Copy to .env for local use. On Render, add each of these in Dashboard > Environment. NEVER commit .env ----
NODE_ENV=development
PORT=8080

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/qline?retryWrites=true&w=majority

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

# Your frontends (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_SAMESITE=lax

# Seeded admin credentials (auto-seeded on server startup & used by `npm run seed:admin`)
ADMIN_EMAIL=admin@qline.app
ADMIN_PASSWORD=
ADMIN_NAME=Qline Admin
ADMIN_EMAILS=

APP_NAME=Qline
DEFAULT_TIMEZONE=Asia/Kolkata

# Email for OTP codes. Render free blocks SMTP ports, so use gmail_api (HTTPS) or brevo.
#   gmail_api | brevo | smtp | console (dev only: prints the code in the server log)
MAIL_PROVIDER=console
MAIL_FROM_EMAIL=you@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Google sign-in: your Firebase project id (Firebase console > Project settings)
FIREBASE_PROJECT_ID=

# Public URLs of the two apps (used for the button in the welcome email)
CUSTOMER_APP_URL=
ORG_APP_URL=

# Optional Web Push VAPID keys (auto-generated in DB if left blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@qline.app
